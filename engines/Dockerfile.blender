# syntax=docker/dockerfile:1.7
# PAI engine image: blender (Blender 5.2.2 LTS, official build checked against its SHA-256; Cycles on the GPU via NVIDIA CDI/OptiX) (ADR 0004). Toolchain only: the release's native/ scripts are mounted read-only at run time,
# so a script change never rebuilds an image. Installed by the same tools/setup_*.py as the host, into the same
# layout (PAI_TOOLS_DIR=/opt/pai/tools), so the engine runtime maps a host tool path to the image by prefix.
ARG BASE=public.ecr.aws/docker/library/ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PAI_TOOLS_DIR=/opt/pai/tools PAI_ENV_FILE=/tmp/pai-setup.env
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates python3 python3-venv xz-utils libx11-6 libxfixes3 libxrender1 libxi6 libxkbcommon0 libsm6 libgl1 libegl1 libdbus-1-3 libfontconfig1 libxxf86vm1 libxext6 libgomp1 libice6 \
 && rm -rf /var/lib/apt/lists/*
COPY --chmod=0644 tools/setup_native_tools.py /opt/pai/src/tools/
RUN python3 /opt/pai/src/tools/setup_native_tools.py && rm -f /opt/pai/tools/*.tar.xz \
 && /opt/pai/tools/blender-5.2.2-linux-x64/blender --version | head -1 | grep -q "Blender 5.2.2" \
 && find /opt/pai/tools -name __pycache__ -prune -exec rm -rf {} + && rm -rf /opt/pai/src /tmp/pai-setup.env \
 && chmod -R a+rX,go-w /opt/pai
ARG PAI_IMAGE_VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/noteflowai/pai-engine" org.opencontainers.image.title="pai-engine-blender"
ENV PAI_IMAGE_VERSION=${PAI_IMAGE_VERSION} PAI_ENGINE=blender HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
USER 65534:65534
WORKDIR /tmp
