# syntax=docker/dockerfile:1.7
# PAI engine image: newton (Newton 1.6 / NVIDIA Warp, hash-locked; GPU via NVIDIA CDI when present, else CPU) (ADR 0004). Toolchain only: the release's native/ scripts are mounted read-only at run time,
# so a script change never rebuilds an image. Installed by the same tools/setup_*.py as the host, into the same
# layout (PAI_TOOLS_DIR=/opt/pai/tools), so the engine runtime maps a host tool path to the image by prefix.
ARG BASE=public.ecr.aws/docker/library/ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PAI_TOOLS_DIR=/opt/pai/tools PAI_ENV_FILE=/tmp/pai-setup.env
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates python3 python3-venv libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --chmod=0644 native/newton-requirements.txt /opt/pai/src/native/
# Only the Newton venv: setup_physics.py's physics lock is not part of this image.
RUN python3 -m venv /opt/pai/tools/newton-1 && /opt/pai/tools/newton-1/bin/python -m pip install -q --no-cache-dir --no-input --require-hashes --no-deps --only-binary :all: \
      -r /opt/pai/src/native/newton-requirements.txt && rm -rf /opt/pai/tools/newton-1/lib/python3*/site-packages/pip \
 && /opt/pai/tools/newton-1/bin/python -c "import newton, warp; print('newton', newton.__version__, 'warp', warp.__version__)" \
 && find /opt/pai/tools -name __pycache__ -prune -exec rm -rf {} + && rm -rf /opt/pai/src /tmp/pai-setup.env \
 && chmod -R a+rX,go-w /opt/pai
ARG PAI_IMAGE_VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/noteflowai/pai-engine" org.opencontainers.image.title="pai-engine-newton"
ENV PAI_IMAGE_VERSION=${PAI_IMAGE_VERSION} PAI_ENGINE=newton HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
USER 65534:65534
WORKDIR /tmp
