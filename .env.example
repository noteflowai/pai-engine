# Trusted local configuration; no credentials. Use absolute paths.
PORT=4317
PAI_STATE=/absolute/path/to/private/workbench-state
PAI_ROBOT_ROOT=/absolute/path/to/robot-reel
PAI_STRESS_SOURCE=/absolute/path/to/robot-reel/docs/stress
PAI_EVALARC_ROOT=/absolute/path/to/evalarc
PAI_RADAR_FILE=/absolute/path/to/physical-ai-radar/radar/latest.json
PAI_CONTROL_ROOT=/absolute/path/to/noteflow-agent-control
PAI_BLENDER=/absolute/path/to/current-blender/blender
# Optional; requires existing reviewed native configuration. No new budget ledger.
# PAI_CONTROLLER_ENTRYPOINT=/absolute/path/to/noteflow-agent-control/.runtime/compiled/flows/execute.js
# PAI_CONTROLLER_DATABASE=/absolute/path/to/existing-ledger.sqlite3
# Visual review: 1 when the executor accepts digest-bound images (runtime-pins.json executor.accepts; set by the installers).
# PAI_EXECUTOR_IMAGES=1
# Optional physics-AI tools: npm run setup:prescreen (NVIDIA GPU) writes PAI_PRESCREEN_DIR; setup:physics -- --with-newton writes PAI_NEWTON_PYTHON.

# AWS deployment only: all values are required together. Default remains local.
# PAI_LISTEN_HOST=0.0.0.0
# PAI_PUBLIC_ORIGIN=https://pai.oneai.host
# PAI_AUTH_ALB_ARN=arn:aws:elasticloadbalancing:ap-northeast-1:ACCOUNT:loadbalancer/app/NAME/ID
# PAI_AUTH_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/POOL_ID
# PAI_AUTH_CLIENT_ID=COGNITO_APPLICATION_CLIENT_ID
# PAI_AUTH_LOGOUT_URL=https://YOUR_POOL_DOMAIN.auth.ap-northeast-1.amazoncognito.com/logout?client_id=CLIENT_ID&logout_uri=https%3A%2F%2Fpai.oneai.host%2F

# Amazon Bedrock AgentCore runtimes (docs/AGENTCORE.md); default AWS credential chain, IAM SigV4.
# PAI_AGENTCORE_AGENT_ARN=arn:aws:bedrock-agentcore:ap-northeast-1:ACCOUNT:runtime/pai_kiro_agent-ID
# PAI_AGENTCORE_SANDBOX_ARN=arn:aws:bedrock-agentcore:ap-northeast-1:ACCOUNT:runtime/pai_cad_sandbox-ID

# Release seals (optional). RFC 3161 time-stamping authority: only a SHA-256 digest of the signature is sent.
# PAI_TSA_URL=http://timestamp.digicert.com
# PAI_TSA_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Write-once archive of sealed packages in an S3 bucket with Object Lock (the AWS stack creates one).
# PAI_PACKAGE_ARCHIVE_BUCKET=
# PAI_PACKAGE_RETENTION_DAYS=365
# PAI_PACKAGE_LOCK_MODE=COMPLIANCE
# Strands Robots cross-check (npm run setup:robots): pinned venv and offline MuJoCo Menagerie; simulation only.
# PAI_ROBOTS_PYTHON=/absolute/path/.state/tools/robots-1/bin/python
# PAI_ROBOTS_ASSETS=/absolute/path/.state/tools/robots-assets
# bubblewrap used for generated CAD code and the robots cross-check (default: bwrap on PATH).
# PAI_BWRAP=/usr/bin/bwrap
# Strands Decider service (npm run setup:decider; strands-decider serve); loopback or private address only. Triage and suggestions, never verdicts.
# PAI_DECIDER_URL=http://127.0.0.1:8801/v1/systemone
# PAI_DECIDER_MODEL=strands-decider-2B-qwen3.5-v1-2610
