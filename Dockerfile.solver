# syntax=docker/dockerfile:1.7
# PAI FEA job image for AWS Batch on Fargate (linux/amd64): one FEA point per job (native/solver_job.py).
# Built FROM the physics engine image (ADR 0004; engines/Dockerfile.physics, pinned by its immutable tag and recorded
# digest), so a Batch point and a point on the workbench host run the very same CadQuery / Gmsh / CalculiX toolchain.
# This layer only adds the job's scripts (the job has no release to mount them from). No credentials in the image;
# the job role grants only the jobs/ prefix of the solver bucket.
ARG ENGINE_BASE
FROM ${ENGINE_BASE}
USER 0:0
COPY --chmod=0644 native/cad_point.py native/cad_recipe.py native/cad_bearing.py native/cad_checks.py native/fea_core.py native/fea_bracket.py native/fea_pillow.py native/solver_job.py /opt/pai/native/
RUN /opt/pai/tools/calculix-2.21/ccx -v 2>&1 | grep -q "Version 2.21" \
 && /opt/pai/tools/physics-1/bin/python -c "import gmsh, numpy, boto3; assert gmsh.__version__ == '4.15.2'" \
 && /opt/pai/tools/cadquery-2.8.0/bin/python -W ignore -c "import cadquery as cq; assert cq.__version__ == '2.8.0'"
ARG PAI_IMAGE_VERSION=dev
ENV PAI_IMAGE_VERSION=${PAI_IMAGE_VERSION} PAI_CADQUERY_PYTHON=/opt/pai/tools/cadquery-2.8.0/bin/python PAI_CCX=/opt/pai/tools/calculix-2.21/ccx OMP_NUM_THREADS=2
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["/opt/pai/tools/physics-1/bin/python", "-I", "/opt/pai/native/solver_job.py"]
